# relay-server configuration (docs/architecture.md §9). Every value below is the default; an empty value
# means "unset". Copy to .env for local use — .env is git-ignored. Never commit real tokens.

# Listen port; Railway injects it. The relay binds 0.0.0.0.
PORT=8787
# pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Bearer token for GET /metrics (>= 32 printable characters, e.g. `openssl rand -base64 32`); empty disables
# /metrics (404).
METRICS_TOKEN=
# Idle TTL in seconds while a session has no connected viewers (protocol §4.4); at most 1800 (protocol maximum).
SESSION_TTL_S=1800
# Seconds a session waits for its publisher to resume after a disconnect (protocol §9.1); at most 120.
PUBLISHER_GRACE_S=120
# Hard cap on a session's lifetime in seconds (12 h); at most 43200.
SESSION_MAX_LIFETIME_S=43200
# Seconds a released code is kept out of circulation (ADR 0008); at least 60.
CODE_QUARANTINE_S=600
# Per-snapshot cap in bytes; at most the protocol maximum 67108864 (64 MiB).
MAX_SNAPSHOT_BYTES=67108864
# Global budget in bytes for cached + in-flight snapshots of all sessions (512 MiB); >= 2 x MAX_SNAPSHOT_BYTES.
MAX_TOTAL_SNAPSHOT_BYTES=536870912
# Global cap in bytes on the sum of all viewer send buffers (160 MiB, >= 8 MiB); slowest consumers closed 4010 above it.
MAX_TOTAL_BUFFERED_BYTES=167772160
# Viewers per session; at most the protocol maximum 20.
MAX_VIEWERS=20
# Live sessions on this relay.
MAX_SESSIONS=100
# Comma-separated browser origins allowed on /ws (exact match; http only for localhost), e.g. http://localhost:5173.
# Empty: https://${RAILWAY_PUBLIC_DOMAIN} on Railway, otherwise only clients without an Origin header (Slicer, Unity).
ALLOWED_ORIGINS=
# true: the client IP is the X-Forwarded-For entry added by the immediate peer (the Railway edge), never one a
# client sent itself; false: the socket address (direct local access). Values: true or false. true assumes the
# relay is reachable only through the Railway edge (no public TCP proxy, no other service in front).
TRUST_PROXY=true
# SIGTERM -> SIGKILL window in seconds for the 4008 drain on redeploy (set the same value in Railway).
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
