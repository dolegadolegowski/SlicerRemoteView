{
  "name": "@slicerremoteview/relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "SlicerRemoteView relay: session codes, WebSocket fan-out from the 3D Slicer publisher to viewers, cached snapshots, static web-viewer hosting (docs/protocol.md v1.0).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "load:smoke": "tsx scripts/load-smoke.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.4",
    "@slicerremoteview/shared": "^0.1.0",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
