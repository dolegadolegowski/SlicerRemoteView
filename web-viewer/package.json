{
  "name": "@slicerremoteview/web-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "SlicerRemoteView mobile browser 3D viewer (Vite, TypeScript, three.js; optional WebXR for Quest Browser).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "node scripts/copy-xr-profiles.mjs && vite",
    "build": "node scripts/copy-xr-profiles.mjs && tsc -p tsconfig.json --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slicerremoteview/shared": "^0.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@slicerremoteview/fake-slicer": "^0.1.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@webxr-input-profiles/assets": "1.0.20",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "iwer": "2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
